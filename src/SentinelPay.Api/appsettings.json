{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379,abortConnect=false",
    "RabbitMq": ""
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Redis": {
    "Enabled": true
  },
  "Outbox": {
    "DispatcherEnabled": true
  },
  "Webhooks": {
    "mock-bank": {},
    "sandbox-wallet": {}
  },
  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "StaleAfterMinutes": 2,
    "BatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
