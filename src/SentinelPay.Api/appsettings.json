{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379,abortConnect=false",
    "RabbitMq": ""
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "DevelopmentMerchant": {
    "Seed": false,
    "Id": "2dc5f437-0a11-4c67-a810-b3e784470f73",
    "Name": "Acme Commerce Sandbox"
  },
  "Redis": {
    "Enabled": true
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "BatchSize": 20,
    "MaxAttempts": 12,
    "PollIntervalMilliseconds": 2000,
    "ClaimSeconds": 30
  },
  "Messaging": {
    "Provider": "RabbitMq",
    "ConsumerEnabled": true,
    "Exchange": "sentinelpay.events",
    "AuditQueue": "sentinelpay.audit.v2",
    "DeadLetterExchange": "sentinelpay.dead-letter",
    "AuditDeadLetterQueue": "sentinelpay.audit.dlq"
  },
  "Providers": {
    "AcquirerHttp": {
      "BaseUrl": "http://localhost:8090",
      "TimeoutSeconds": 3
    }
  },
  "Webhooks": {
    "SignatureToleranceSeconds": 300,
    "mock-bank": {},
    "sandbox-wallet": {},
    "acquirer-http": {}
  },
  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "StaleAfterMinutes": 2,
    "BatchSize": 50
  },
  "PaymentExpiry": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
